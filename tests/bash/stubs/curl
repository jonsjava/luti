#!/usr/bin/env bash
# curl stub for unit tests. Records the call and prints a canned response.
#   $STUB_DIR/args      one argument per line (last call)
#   $STUB_DIR/headers   contents of every -H @file argument
#   $STUB_DIR/body      request body read from --data-binary @-
#   $STUB_DIR/bodies    every request body, appended
#   $STUB_DIR/calls     one line per call: METHOD URL
#   $STUB_DIR/response  body to print;  $STUB_DIR/code  HTTP status to print (-w)
#   $STUB_DIR/routes/METHOD_path_with_underscores   per-route body (query string ignored),
#       e.g. routes/GET_api_v4_post_list; overrides response for that route
set -u
: "${STUB_DIR:?}"
printf '%s\n' "$@" >"$STUB_DIR/args"
: >"$STUB_DIR/headers"
: >"$STUB_DIR/body"
method=GET url="" wfmt=""
while [[ $# -gt 0 ]]; do
	case $1 in
		-X) method=$2; shift ;;
		-H)
			if [[ $2 == @* ]]; then cat "${2#@}" >>"$STUB_DIR/headers"; else printf '%s\n' "$2" >>"$STUB_DIR/headers"; fi
			shift
			;;
		--data-binary) [[ $2 == @- ]] && cat >"$STUB_DIR/body" && cat "$STUB_DIR/body" >>"$STUB_DIR/bodies"; shift ;;
		-w) wfmt=$2; shift ;;
		--max-time) shift ;;
		-*) ;;
		*) url=$1 ;;
	esac
	shift
done
printf '%s %s\n' "$method" "$url" >>"$STUB_DIR/calls"
route=${url#*://*/}
route=${route%%\?*}
route="$STUB_DIR/routes/${method}_${route//\//_}"
if [[ -f $route ]]; then cat "$route"; else cat "$STUB_DIR/response"; fi
[[ -n $wfmt ]] && printf '\n%s' "$(cat "$STUB_DIR/code")"
exit 0
